# Copy to docker/rocm-serve/.env (start.sh writes it for you).
# The model directory (fetch-model.sh downloads it): mounted read-only.
MODEL_DIR=/path/to/qwen38fn-int4-autoround
# The host's GIDs owning /dev/kfd and /dev/dri/renderD*: `getent group video render` (they vary between distros).
VIDEO_GID=44
RENDER_GID=991
